# Lia — variáveis de ambiente do produto VIGENTE (reescrito em 02/09/2026).
# Legado removido nesta data: Twilio, /admin, /chat, /api/v1, Browserbase, Unwrangle,
# callback Apify do motor antigo. O que cada flag faz está em AGENTS.md (busque o nome).
# Em deploy (Vercel) todo segredo ausente NEGA (fail-closed); localmente, libera.

# ---- Banco (Postgres/Supabase). DIRECT_URL é a conexão sem pooler, usada pelas migrations.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/shopping_agent?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/shopping_agent?schema=public"

# ---- WhatsApp (Meta Cloud API direta). Provider: meta (produção) | mock (dev/testes).
WHATSAPP_PROVIDER="mock"
WHATSAPP_VERIFY_TOKEN=""
WHATSAPP_APP_SECRET=""
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_BUSINESS_ACCOUNT_ID=""
# Carrossel da vitrine (07/09): template de MARKETING (cobrado ~R$0,33/envio), 2–3 cards
# numa mensagem. Criar com /api/ops/meta-setup?action=carousel; conferir ?action=templates;
# ligar só depois de APPROVED. Desligado = cards soltos de sempre (grátis na janela de 24h).
LIA_CAROUSEL="false"
LIA_CAROUSEL_TEMPLATE="vitrine_carrossel_v2"
WHATSAPP_GRAPH_API_VERSION="v21.0"
# Segredo do formato mock (curl interno/testes) no header x-webhook-secret.
WHATSAPP_WEBHOOK_SECRET=""
# Janela de atribuição do clique/anúncio ao pedido criado na conversa (1–90 dias).
# O webhook da Meta é a fonte principal; a tag [AD:CODIGO] na mensagem é apenas fallback.
LIA_AD_ATTRIBUTION_DAYS="7"
# Número público (só dígitos, com DDI) usado nos links wa.me da landing.
NEXT_PUBLIC_LIA_WHATSAPP_NUMBER="5511978444813"
# Rodapé da landing: só aparecem quando preenchidos (sem deploy: setar na Vercel e redeploy)
# NEXT_PUBLIC_LIA_INSTAGRAM_URL="https://instagram.com/liadelivery"
# NEXT_PUBLIC_LIA_LINKEDIN_URL="https://linkedin.com/company/liadelivery"
LIA_PUBLIC_URL="https://liadelivery.com.br"

# ---- Painel /ops (obrigatória em deploy; NÃO cai em API_TOKEN). Abra /ops?key=<valor> uma vez.
OPS_TOKEN=""
# Token bearer das rotas técnicas remanescentes (purchase-worker usa o seu próprio).
API_TOKEN=""
# ---- Operador CONTRATADO (15/09/2026). Sem OPS_OPERATOR_TOKEN não existe papel reduzido e
# o link "ops" do operador falha fechado (nunca vira sessão de dono).
OPS_OPERATOR_TOKEN=""
# Telas de seleção e treinamento (/ops/teste e /ops/treinamento, por ?key=). Sem ela as duas
# respondem "link não é válido" para qualquer chave.
OPS_TEST_TOKEN=""
# Telefone (E.164) de quem COMPRA: recebe pedido pago, pedido parado e cotação manual.
LIA_OPERATOR_PHONE=""
# Telefone (E.164) do DONO: cobrança falhada, pagamento fora do esperado, estorno automático,
# reclamação de cobrança. VAZIO = o número do operador vira dono e recebe tudo isso.
LIA_OWNER_PHONE=""
# Outros telefones com poder de operador (vírgula). Quem manda "ops" pra Lia recebe o link
# de login do /ops (assinado com o segredo do SEU papel, 10 min).
LIA_ADMIN_PHONES=""
# Janela em que existe alguém para comprar (horário de São Paulo). Só muda o que a Lia
# promete ao cliente quando o pagamento cai fora dela.
LIA_OPERATOR_HOURS="9-20"
# Alerta de pedido PAGO. Vazio = liga sozinho quando há operador contratado (telefone de
# compra diferente do telefone do dono). "false" DESLIGA à força — não use com contratado.
LIA_OPERATOR_PAID_ALERT=""
# Identificação fiscal mostrada quando o cliente pergunta CNPJ/NF.
LIA_BUSINESS_INFO=""
# Template APROVADO na Meta (WhatsApp Manager → Templates → Utility) para avisos fora da
# janela de 24h — sem ele, aviso proativo e alerta ao operador fora da janela NÃO saem.
# Sugestão de body: "Olá! Aqui é a Lia, com uma atualização sobre o seu pedido {{1}}: {{2}} Se precisar de algo, é só responder esta mensagem." (nome livre, ex.: pedido_atualizacao).
LIA_TEMPLATE_ORDER_UPDATE=""
LIA_TEMPLATE_LANG="pt_BR"
# Estorno automático (04/09): pedido pago sem compra na loja, bloqueado há N h ou sem compra
# há M h → estorna sozinho pelo provedor e avisa o cliente. Kill-switch: LIA_AUTO_REFUND_OFF=true.
LIA_AUTO_REFUND_BLOCKED_HOURS="6"
LIA_AUTO_REFUND_STALE_HOURS="24"
LIA_AUTO_REFUND_OFF=""
# Só pedidos pagos a partir desta data entram na regra (default 2026-09-04T12:00:00Z).
LIA_AUTO_REFUND_SINCE=""
# Plano B (04/09): substituto pode custar até esta fração acima do pago (absorvido). Default 0.15.
LIA_PLAN_B_PRICE_TOLERANCE=""
# Recursos do WhatsApp (04/09): id do Flow de endereço publicado na Meta (vazio = pede por
# texto); LIA_TYPING_OFF=true desliga o "digitando…"; timeout da geocodificação reversa.
LIA_FLOW_ADDRESS_ID=""
# Flow "Escolher minha lista" (07/10): LIA_LIST_FLOW=true liga o formulário para listas de 2+
# itens com opção (só provedor meta; lista com remédio isento não usa). LIA_FLOW_LIST_ID força o
# id do Flow (vazio = o publicado com o nome lista_lia_v1).
LIA_LIST_FLOW=""  # true = todos; admin = só LIA_ADMIN_PHONES/dono (teste ao vivo)
LIA_FLOW_LIST_ID=""
LIA_TYPING_OFF=""
LIA_GEOCODE_TIMEOUT_MS="4000"
# Entrega expressa da loja só é oferecida se custar até este extra sobre a mais barata (R$).
LIA_FAST_FREIGHT_MAX_EXTRA="20"
# "Pra hoje": entrega mais rápida da loja abaixo disto (minutos) conta como hoje. Default 1440.
LIA_SAME_DAY_MAX_MINUTES="1440"
# Áudio e foto do cliente (15/09): a Lia transcreve o áudio e lê a foto, e o texto derivado
# segue pelo mesmo NLU de quem digitou. "false" desliga cada tipo separado (custo e latência
# diferentes) e volta ao aviso de "só leio texto". Teto do arquivo e timeouts do download.
LIA_MEDIA_AUDIO=""
LIA_MEDIA_IMAGE=""
LIA_MEDIA_MAX_BYTES="12000000"
LIA_MEDIA_TIMEOUT_MS="15000"
LIA_AUDIO_TIMEOUT_MS="20000"
LIA_VISION_TIMEOUT_MS="20000"

# ---- IA (OpenAI Responses API). Sem chave: extração/rerank/roteador caem no determinístico.
OPENAI_API_KEY=""
# Transcrição do áudio e leitura da foto (default: gpt-4o-mini-transcribe e o OPENAI_MODEL).
OPENAI_TRANSCRIBE_MODEL=""
OPENAI_VISION_MODEL=""
OPENAI_MODEL="gpt-5.4-mini"
LIA_AI_TIMEOUT_MS="10000"
LIA_SEARCH_RERANK_TIMEOUT_MS="6000"
LIA_SEARCH_RERANK_OFF=""
LIA_LLM_ROUTER="true"
# Classificar ANTES de buscar (frase solta passa pelo roteador; lista vai direto).
LIA_CLASSIFY_FIRST="true"

# ---- Pagamentos
# Mercado Pago (Pix + Checkout Pro). Sem token: mock SÓ fora de deploy de produção.
MERCADO_PAGO_ACCESS_TOKEN=""
MERCADO_PAGO_WEBHOOK_SECRET=""
MERCADO_PAGO_WEBHOOK_URL="https://liadelivery.com.br/api/mercadopago/webhook"
LIA_MP_TIMEOUT_MS="10000"
# Bolha nativa de Pix (order_details + pix_dynamic_code). As quatro são necessárias.
LIA_NATIVE_PIX="0"
LIA_PIX_MERCHANT_NAME=""
LIA_PIX_KEY=""
LIA_PIX_KEY_TYPE="CNPJ"
# Cartão salvo (Pagar.me card-on-file + botão "Pagar •••• 1234").
LIA_ENABLE_SAVED_CARD="false"
# MDR do cartão em 1x repassado por gross-up (4,99% = 0.0499).
LIA_CARD_MDR="0.0499"
PAGARME_SECRET_KEY=""
PAGARME_PUBLIC_KEY=""
PAGARME_WEBHOOK_TOKEN=""
PAGARME_BASE_URL="https://api.pagar.me/core/v5"
# Dev: cartão de mentira (ignorado em deploy de produção).
PAGARME_MOCK=""
# One-Click nativo da Meta (negado pela Meta em 08/2026; manter false).
LIA_ENABLE_WA_PAYMENTS="false"
# Cron de reconciliação (vercel.json → /api/cron/reconcile-payments). A Vercel manda como Bearer.
CRON_SECRET=""

# ---- Preço
# Modelo (08/10): "service_fee" (padrão) = preço da loja em cada item + "Taxa de serviço da Lia" em
# linha própria, compra e nota fiscal no CPF do cliente; "markup" = margem embutida no preço, nota
# no nome da Lia (modelo antigo). A margem em R$ é a mesma nos dois.
LIA_PRICING_MODE="service_fee"
# 1ª faixa da margem (1.1 = 10%); faixas marginais acima em LIA_MARKUP_TIERS.
LIA_PRICE_MARKUP="1.1"
# Remédio isento de prescrição no CPF do cliente (29/09). LIGADO em produção desde 05/10 (ver o
# topo do AGENTS.md). Taxa da Lia em pedido com remédio (linha própria na cotação).
LIA_MEDICINE_MIP="true"
LIA_MEDICINE_SERVICE_FEE="4.90"
# E-mail do perfil VTEX por CPF; vazio = contato+c<hash>@<domínio da conta da loja>.
LIA_MEDICINE_BUYER_EMAIL_TEMPLATE=
LIA_MARKUP_TIERS="200:0.06,500:0.04,1000:0.03"

# ---- Vitrine (18 lojas + Mercado Livre)
# Mercado Livre como cauda longa (actor Apify; ~R$0,03/busca).
LIA_ENABLE_MERCADOLIVRE="false"
# Cauda longa AUTOMÁTICA por padrão (07/09): sem match bom nas vitrines, o ML entra na
# mesma busca, sem pergunta. "true" volta ao modo opt-in ("procuro no Mercado Livre?").
LIA_LONGTAIL_OPTIN="false"
APIFY_API_TOKEN=""
APIFY_MERCADO_LIVRE_ACTOR="karamelo/mercadolivre-scraper-brasil-portugues"
APIFY_MERCADO_LIVRE_MAX_WAIT_MS="90000"
APIFY_MERCADO_LIVRE_POLL_MS="2500"
LIA_ML_MEMORY_MB=""
# API oficial do ML (só busca; app do DevCenter ainda bloqueado — ver docs/ticket-suporte-mercadolivre.md).
ML_CLIENT_ID=""
ML_CLIENT_SECRET=""
MERCADO_LIVRE_REDIRECT_URI="https://liadelivery.com.br/api/mercadolivre/oauth/callback"
# Lojas individuais: LIA_ENABLE_<LOJA>=false desliga; LIA_<LOJA>_MIN_ORDER e
# LIA_STORE_FREIGHT_<LOJA>/LIA_STORE_FREE_ABOVE_<LOJA> calibram mínimo e frete por loja.
LIA_ENABLE_BOTICARIO=""
LIA_ENABLE_PETZ=""
LIA_ENABLE_OBA=""
LIA_ENABLE_COBASI=""
LIA_ENABLE_DROGARIASP=""
LIA_ENABLE_PAGUEMENOS=""
LIA_ENABLE_DIVVINO=""
LIA_ENABLE_IMIGRANTES=""
LIA_ENABLE_NATURALDATERRA=""
LIA_ENABLE_GIULIANAFLORES=""
LIA_ENABLE_DECATHLON=""
# Frete/estoque ao vivo (checkout VTEX) — desligado nos testes. Cobrança automática só do
# que a loja confirmou ao vivo; LIA_CHARGE_ONLY_VERIFIED=false aceita a tabela (não recomendado).
LIA_CHARGE_ONLY_VERIFIED="true"
LIA_LIVE_FREIGHT_OFF=""
LIA_LIVE_FREIGHT_MAX=""
LIA_LIVE_FREIGHT_TIMEOUT_MS=""
# Seed de catálogo para testes/golden (nunca em produção).
LIA_RETAILER_TEST_SEED=""
# Hosts de imagem que o WhatsApp não consegue buscar (vira texto).
LIA_MEDIA_BLOCK_HOSTS="images.petz.com.br"
LIA_SEND_PHOTOS=""

# ---- Conversa (TTLs e limites)
LIA_INSTANT_QUOTE="true"
LIA_BASKET_COMPOSER_OFF=""
LIA_BULK_AUTOPICK_MAX=""
LIA_CART_TTL_MS="1800000"
LIA_QUOTE_ABANDON_TTL_MS="3600000"
# 08/10: total/entrega na mesa há mais de 10 min + pedido de produto do nada (sem "adiciona") = pedido
# NOVO em silêncio (a cotação velha é cancelada sem aviso). Mesmo relógio da cobrança Pix emitida.
LIA_NEW_MISSION_AFTER_MS="600000"
# 08/10: mesma mensagem de produto reenviada em menos de 3 min (reenvio por impaciência) fica muda.
LIA_DUPLICATE_INBOUND_MS="180000"
# 08/10: teto de chamadas simultâneas às lojas (busca ao vivo + simulação de frete). Lista de 4 itens
# sem fila = ~150 chamadas de uma vez e todas estouravam o timeout ("não tinha gin").
LIA_STORE_FETCH_CONCURRENCY="32"
LIA_RETAILER_QUOTE_TTL_MINUTES="5"
LIA_CONVERSATION_TTL_MIN=""
LIA_TURN_DEADLINE_MS="45000"
LIA_TURN_LOCK_TTL_MS="180000"
LIA_TURN_LOCK_MAX_WAIT_MS="120000"
LIA_RESCUE_BUDGET_MS="90000"
LIA_VIACEP_TIMEOUT_MS=""
LIA_MEDIA_PREFLIGHT_TIMEOUT_MS=""

# ---- Cobertura: estado-sp | grande-sp | capital (+ LIA_COVERAGE_CITIES/_UFS/_CEP_PREFIXES/_LABEL/_OFF).
LIA_COVERAGE_PRESET="estado-sp"

# ---- Comprador local (scripts/retail-buyer): token do comprador. O caminho antigo da
# tarefa horária do ChatGPT (PURCHASE_AUTOMATION_MODE/cart_only) foi aposentado em 11/09.
LIA_PURCHASE_WORKER_TOKEN=""
LIA_PURCHASE_WORKER_ID=""

# ---- Testes e CI
# Com TEST_DATABASE_URL, a suíte inteira fala com esse banco (nunca com o de produção).
# `npm run test:local` sobe um Postgres embutido e define isso sozinho.
TEST_DATABASE_URL=""
# Na CI: banco indisponível = FALHA (sem ela, os E2E pulam em silêncio).
LIA_REQUIRE_DB=""

# Revisão 06/09 — requer migration DeliveryEvent antes do código novo.
# Habilita apenas geração de jobs de PREPARAÇÃO, nunca checkout final.
LIA_PURCHASE_PREP_STORES=mercadolivre
# Ingestão interna de evidência de rastreio; manter false sem leitor homologado.
LIA_TRACKING_INGEST_ENABLED=false

# Comprador de navegador v2: sessão e aprovação concreta no /ops, independente do modo v1.
# Conta operacional precisa estar habilitada no painel; adaptador precisa ser homologado.
LIA_PURCHASE_SUBMIT_OFF=false
# Autorização 07/09: até R$500/pedido E R$500/dia (São Paulo), frete incluso.
# Somente lojas com checkout/comprovante validados. Vazio = nenhuma compra automática.
# ML segue assistido. Login/cartão e conta ativa no painel também são obrigatórios.
LIA_AUTO_PURCHASE_STORES=""
# Fila manual (loja sem compra automática): horas sem compra antes do estorno automático.
LIA_AUTO_REFUND_MANUAL_HOURS=48
# Pix de SAÍDA (a Lia paga a loja): vazio = desligado. asaas | mock (mock nunca em produção).
LIA_PIX_OUT_PROVIDER=
LIA_PIX_OUT_OFF=
ASAAS_API_KEY=
ASAAS_ENV=sandbox
# Minutos após o Pix pago sem a loja confirmar → botão Confirmar/Estornar ao operador.
LIA_PIX_STORE_CONFIRM_MIN=30
# Comprador local sem heartbeat há N min com pedido pago esperando → alerta (1×/hora).
LIA_BUYER_SILENT_MIN=10
# Botões assinados do operador no WhatsApp (op1.…); true = só texto + link do painel.
LIA_OPS_BUTTONS_OFF=
# Decisão de 15/09/2026: operador humano compra. `true` impede qualquer job automático de
# nascer e manda todo pedido pago para a fila manual do /ops. Produção está com `true`.
LIA_AUTO_PURCHASE_OFF=true
# Token separado: leitor pode registrar status, mas não aprovar/finalizar compras.
LIA_TRACKING_WORKER_TOKEN=""
# OAuth local de leitura da caixa operacional. Guardar preferencialmente no Chaves;
# nunca expor ao navegador ou à Vercel do atendimento.
LIA_GMAIL_CLIENT_ID=""
LIA_GMAIL_CLIENT_SECRET=""
LIA_GMAIL_REFRESH_TOKEN=""
# Financeiro por pedido (/ops/financeiro, 23/09): alíquotas usadas SÓ enquanto o Mercado
# Pago não informou a taxa real do pagamento (o cron de reconciliação preenche depois).
# Pix MP = 0,99% do recebedor; cartão pelo Checkout Pro ≈ o MDR repassado (LIA_CARD_MDR).
LIA_MP_PIX_FEE_RATE=0.0099
LIA_MP_CARD_FEE_RATE=0.0499
# Somente no processo local do comprador (não são necessários na Vercel).
LIA_BUYER_DIR=.retail-buyer
LIA_BUYER_MODEL=gpt-5.4-mini
# OPENAI_API_KEY deve ser fornecida ao processo local; ele não carrega .env de produção.

# --- Comprador VTEX no servidor (25/09/2026) ---
# CNPJ (14 dígitos) ou CPF (11) do comprador nas lojas VTEX; pessoa jurídica quando CNPJ.
LIA_BUYER_DOCUMENT=
LIA_BUYER_FIRST_NAME=Lia
LIA_BUYER_LAST_NAME=Delivery
LIA_BUYER_CORPORATE_NAME=Lia Delivery
# Pausa só o comprador do servidor (LIA_AUTO_PURCHASE_OFF pausa tudo).
LIA_SERVER_BUYER_OFF=
# Pedido pago há mais de N horas nunca é comprado sozinho (vai para revisão). Padrão 24.
LIA_SERVER_BUYER_MAX_AGE_HOURS=24
# Leitor de e-mails das lojas no servidor (Gmail somente-leitura, refresh token do Chaves).
LIA_GMAIL_CLIENT_ID=
LIA_GMAIL_CLIENT_SECRET=
LIA_GMAIL_REFRESH_TOKEN=
