{
  "name": "lia",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "purchase-worker:monitor": "node --import tsx scripts/order-monitor.mts monitor",
    "purchase-worker:inspect": "node --import tsx scripts/order-monitor.mts inspect",
    "dev": "next dev",
    "build": "prisma generate && node scripts/migrate-on-build.mjs && next build && node scripts/check-bundle-emoji.mjs",
    "start": "next start",
    "lint": "next lint",
    "test": "LIA_RETAILER_TEST_SEED=true node --import tsx --test --test-concurrency=1 tests/*.test.ts",
    "catalog:refresh": "tsx scripts/refresh-catalogs.mts",
    "test:unit": "node --import tsx --test tests/lia-intents.test.ts tests/lia-copy.test.ts",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:check": "node scripts/check-migrations.mjs",
    "test:e2e": "LIA_RETAILER_TEST_SEED=true LIA_REQUIRE_DB=1 node --import tsx --test --test-concurrency=1 tests/*.test.ts",
    "test:local": "tsx scripts/test-local-db.mts",
    "purchase-worker:run": "tsx scripts/retail-buyer/run.mts run",
    "purchase-worker:setup": "tsx scripts/retail-buyer/run.mts setup",
    "purchase-worker:mailbox-check": "tsx scripts/retail-buyer/run.mts mailbox-check",
    "purchase-worker:mailbox-authorize": "tsx scripts/retail-buyer/authorize-mailbox.mts",
    "purchase-worker:init": "tsx scripts/retail-buyer/run.mts init",
    "purchase-worker:verify": "tsx scripts/retail-buyer/verify.mts",
    "purchase-worker:verify-ui": "tsx scripts/retail-buyer/verify-ui.mts",
    "purchase-worker:once": "tsx scripts/retail-buyer/run.mts once",
    "purchase-worker:probe": "tsx scripts/retail-buyer/run.mts probe",
    "purchase-worker:e3": "tsx scripts/retail-buyer/run.mts e3",
    "purchase-worker:install-service": "bash scripts/retail-buyer/install-launchd.sh"
  },
  "dependencies": {
    "@prisma/client": "5.22.0",
    "@vercel/functions": "^3.7.4",
    "lucide-react": "^0.468.0",
    "next": "^14.2.23",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sharp": "^0.35.5",
    "workflow": "^4.6.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^20.17.10",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "autoprefixer": "^10.4.20",
    "embedded-postgres": "^18.4.0-beta.17",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.23",
    "playwright-core": "^1.63.0",
    "postcss": "^8.4.49",
    "prisma": "5.22.0",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
