generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-arm64-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                     String                  @id @default(cuid())
  name                   String?
  phone                  String                  @unique
  email                  String?
  defaultAddress         String?
  cep                    String?
  // Remédio isento (29/09): compra na farmácia NO NOME do cliente. CPF e nome como vão na
  // nota fiscal, informados pelo próprio cliente no chat, com o instante do consentimento.
  cpf                    String?
  cpfName                String?
  cpfConsentAt           DateTime?
  createdAt              DateTime                @default(now())
  conversations          Conversation[]
  deliveryOrders         DeliveryOrder[]
  paymentCredentials     PaymentCredential[]
  cardEnrollmentSessions CardEnrollmentSession[]
}

// The operational model: a basket of everyday items requested in WhatsApp and
// fulfilled by a pluggable store. Retailer delivery is the default; pickup + courier
// is retained only for formally-authorized partners. Quote, payment, purchase and
// delivery are coordinated from this row and the operator dashboard.
model DeliveryOrder {
  id                    String                 @id @default(cuid())
  userId                String
  conversationId        String?
  phone                 String
  customerName          String?
  // Remédio isento (29/09): o pedido NA FARMÁCIA sai neste CPF/nome (cópia do User no
  // instante do pedido). Nulo = compra no CNPJ da Lia, como todo pedido sem remédio.
  buyerDocument         String?
  buyerName             String?
  // Last acquisition touch present when this order was created. The click id stays
  // on AcquisitionTouch; orders keep a stable attribution snapshot even if the
  // customer later returns through another campaign.
  acquisitionTouchId    String?
  cep                   String?
  deliveryAddress       String?
  // Pluggable supply: storeKey resolves to a StoreConnector in the registry.
  storeKey              String                 @default("oba")
  storeLabel            String                 @default("Oba Hortifruti")
  storeUnit             String?
  storeAddress          String?
  storeOrderNumber      String?
  items                 Json
  // One entry per store fulfillment, including delivery mode and live promise.
  fulfillments          Json?
  itemsSubtotal         Float                  @default(0)
  // "retailer_delivery" is the default; courier keys require an authorized partner.
  courierKey            String                 @default("retailer_delivery")
  courierQuoteId        String?
  deliveryFee           Float                  @default(0)
  serviceFee            Float                  @default(0)
  total                 Float                  @default(0)
  // Financeiro por pedido (23/09): o que foi pago DE VERDADE na loja (produtos + frete,
  // tudo), digitado pelo operador na compra ou preenchido pela compra automática. Nulo =
  // ainda não conferido; o P&L usa itemsSubtotal + deliveryFee como estimativa.
  storePaidTotal        Float?
  // Direct lifecycle: awaiting_payment -> paid -> retailer_preparing
  //                   -> retailer_out_for_delivery -> delivered.
  // Legacy/partner courier: paid -> operator_buying -> ready_for_pickup
  //                         -> dispatched -> delivered.
  // Paid cancellation: refund_pending -> refunded. Unpaid cancellation -> canceled.
  status                String                 @default("awaiting_payment")
  pixId                 String?
  pixCopiaECola         String?
  paidAt                DateTime?
  quoteExpiresAt        DateTime?
  // Generic tracking URL. The historic column name is kept to avoid a risky pilot migration.
  courierTrackingUrl    String?
  courierDispatchedAt   DateTime?
  deliveredAt           DateTime?
  notes                 String?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  user                  User                   @relation(fields: [userId], references: [id])
  purchaseJobs          PurchaseJob[]
  paymentAttempts       PaymentAttempt[]
  cardEnrollmentSession CardEnrollmentSession?
  payments              Payment[]
  events                DeliveryEvent[]
  trackingSubscription  TrackingSubscription?
  acquisitionTouch      AcquisitionTouch?      @relation(fields: [acquisitionTouchId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([quoteExpiresAt])
  @@index([phone])
  @@index([acquisitionTouchId])
  // Revisão 01/09: o cérebro faz findFirst por userId(+status) em quase todo turno.
  @@index([userId, status, createdAt])
}

// Evidência da etapa e envio ao WhatsApp persistidos na mesma transação do pedido.
// accepted = Graph recebeu; delivered/read = recibo do WhatsApp. Nunca confundir.
model DeliveryEvent {
  id                String        @id @default(cuid())
  deliveryOrderId   String
  dedupeKey         String        @unique
  kind              String
  source            String
  sourceReference   String
  occurredAt        DateTime
  message           String
  deliveryStatus    String        @default("pending")
  providerMessageId String?       @unique
  attempts          Int           @default(0)
  lastError         String?
  nextAttemptAt     DateTime?
  lockedAt          DateTime?
  receiptAt         DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  deliveryOrder     DeliveryOrder @relation(fields: [deliveryOrderId], references: [id], onDelete: Cascade)

  @@index([deliveryStatus, nextAttemptAt])
  @@index([deliveryOrderId, occurredAt])
}

// A purchase job is deliberately separate from DeliveryOrder.status. The order status
// remains customer-facing (paid, dispatched, delivered), while this model records the
// operational state of each store fulfillment and makes retries/auditing safe.
model PurchaseJob {
  id                String            @id @default(cuid())
  deliveryOrderId   String
  // A multi-store DeliveryOrder creates one job per fulfillment.
  fulfillmentKey    String            @default("primary")
  storeKey          String
  storeLabel        String
  storeUnitId       String?
  storeUnitLabel    String?
  status            String            @default("preflight_queued")
  workflowRunId     String?
  browserSessionId  String?
  claimToken        String?
  checkoutHash      String?
  checkoutEvidence  Json?
  checkoutExpiresAt DateTime?
  submissionId      String?           @unique
  submitStartedAt   DateTime?
  cartHash          String?
  cartSnapshot      Json?
  expectedTotal     Float?
  actualTotal       Float?
  storeOrderNumber  String?
  approvalStatus    String            @default("not_requested")
  approvalMaxTotal  Float?
  approvalCartHash  String?
  approvedBy        String?
  approvedAt        DateTime?
  approvalExpiresAt DateTime?
  lastErrorCode     String?
  lastErrorMessage  String?
  nextAttemptAt     DateTime?
  lockedAt          DateTime?
  completedAt       DateTime?
  // Mercado Livre degrau C: instante em que o dono confirmou a compra no app.
  ownerConfirmedAt  DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  deliveryOrder     DeliveryOrder     @relation(fields: [deliveryOrderId], references: [id], onDelete: Cascade)
  items             PurchaseItem[]
  attempts          PurchaseAttempt[]

  @@unique([deliveryOrderId, fulfillmentKey])
  @@index([status, nextAttemptAt])
  @@index([storeKey, status])
}

// Maps the product chosen by the customer to the immutable live SKU used by a retailer.
// A low-confidence or ambiguous match must be sent to /ops, never purchased.
// Reserva durável antes do clique. Não apagar com pedido, estorno ou reconciliação.
model PurchaseSpend {
  submissionId  String    @id
  purchaseJobId String
  budgetDay     String
  amountCents   Int
  authorization String
  // reserved: conta no teto do dia; released: liberada por decisão auditada no /ops.
  status        String    @default("reserved")
  releasedAt    DateTime?
  releaseNote   String?
  createdAt     DateTime  @default(now())

  @@index([budgetDay])
}

model PurchaseItem {
  id                 String      @id @default(cuid())
  purchaseJobId      String
  requestedSku       String
  requestedName      String
  requestedQty       Int
  requestedUnitPrice Float?
  productUrl         String?
  retailerSku        String?
  retailerProductId  String?
  retailerSellerId   String?
  ean                String?
  resolvedName       String?
  expectedUnitPrice  Float?
  actualUnitPrice    Float?
  matchConfidence    Float?
  status             String      @default("pending")
  raw                Json?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
  purchaseJob        PurchaseJob @relation(fields: [purchaseJobId], references: [id], onDelete: Cascade)

  @@index([purchaseJobId])
  @@index([status])
}

// Append-only attempt log. Never persist card data, cookies, full browser state or
// customer PII here; logs are only the safe operation metadata necessary to reconcile.
model PurchaseAttempt {
  id               String      @id @default(cuid())
  purchaseJobId    String
  step             String
  status           String      @default("started")
  idempotencyKey   String?
  browserSessionId String?
  details          Json?
  errorCode        String?
  errorMessage     String?
  createdAt        DateTime    @default(now())
  completedAt      DateTime?
  purchaseJob      PurchaseJob @relation(fields: [purchaseJobId], references: [id], onDelete: Cascade)

  // The same durable workflow step must never submit a second retailer order.
  // PostgreSQL permits multiple NULL values, so non-idempotent audit attempts stay valid.
  @@unique([purchaseJobId, idempotencyKey])
  @@index([purchaseJobId, createdAt])
  @@index([status])
}

// One authenticated retailer context represents one physical shopping cart. Jobs may
// scale across orders, but must use that cart sequentially or their items can mix.
// This is a short-lived, database-backed lease rather than an in-memory mutex so it
// survives Vercel function restarts and works across workflow workers.
model PurchaseWorkerLease {
  accountKey String   @id
  token      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([expiresAt])
}

// A Pagar.me card-on-file. Meta receives this row's opaque id as credential_id;
// the provider card id never leaves the backend.
model PaymentCredential {
  id                 String           @id @default(cuid())
  userId             String
  provider           String           @default("pagarme")
  providerCustomerId String
  providerCardId     String
  last4              String
  brand              String?
  consentAt          DateTime?
  consentVersion     String?
  // active | disabled (customer removed it or the provider started declining it)
  status             String           @default("active")
  createdAt          DateTime         @default(now())
  user               User             @relation(fields: [userId], references: [id])
  paymentAttempts    PaymentAttempt[]

  @@unique([provider, providerCardId])
  @@index([userId, status])
}

// One row per one-click charge PRESENTED to the customer. Its id doubles as the
// reference_id echoed back by Meta's payment webhook, so retries/double-taps resolve
// to the same row and can never double-charge; the PSP call reuses it as the
// idempotency key. A resent order_details is a NEW attempt (stale ones expire).
model PaymentAttempt {
  id                String            @id @default(cuid())
  deliveryOrderId   String
  credentialId      String
  amountCents       Int
  // pending -> confirmed (customer tapped pay) -> charged | failed ; expired
  status            String            @default("pending")
  expiresAt         DateTime
  confirmedAt       DateTime?
  providerPaymentId String?
  providerOrderId   String?
  providerChargeId  String?
  workflowRunId     String?
  error             String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  deliveryOrder     DeliveryOrder     @relation(fields: [deliveryOrderId], references: [id])
  credential        PaymentCredential @relation(fields: [credentialId], references: [id])

  @@index([deliveryOrderId])
  @@index([credentialId])
  @@index([providerOrderId])
}

// A short-lived, one-use authorization for the only page that ever collects a
// new card. The opaque secret travels in the URL; only its SHA-256 hash is kept
// in the database, so a database read alone cannot open the form.
model CardEnrollmentSession {
  id              String        @id @default(cuid())
  userId          String
  deliveryOrderId String        @unique
  secretHash      String
  expiresAt       DateTime
  consumedAt      DateTime?
  createdAt       DateTime      @default(now())
  user            User          @relation(fields: [userId], references: [id])
  deliveryOrder   DeliveryOrder @relation(fields: [deliveryOrderId], references: [id])

  @@index([userId, expiresAt])
}

model Conversation {
  id                 String             @id @default(cuid())
  userId             String
  status             String             @default("active")
  intent             String?
  currentStep        String             @default("collecting_request")
  context            String?
  // Lock cooperativo de TURNO (2ª revisão, 11/08): um turno por vez por conversa.
  // Duas mensagens simultâneas liam a mesma cesta e a última gravação apagava o item
  // da primeira. Claim atômico via updateMany; TTL no código (turnLockAt) evita que um
  // turno travado prenda a conversa pra sempre. Funciona entre instâncias serverless.
  turnLock           String?
  turnLockAt         DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  user               User               @relation(fields: [userId], references: [id])
  messages           Message[]
  acquisitionTouches AcquisitionTouch[]

  @@index([userId, status, updatedAt])
}

// A click-to-WhatsApp ad puts a `referral` object on the first inbound message.
// Keep that evidence separate from the conversation text: it is untrusted metadata,
// must not become a product query, and one conversation can be re-opened by more than
// one campaign. `providerMessageId` makes webhook retries idempotent.
model AcquisitionTouch {
  id                String          @id @default(cuid())
  conversationId    String
  providerMessageId String          @unique
  source            String
  campaignCode      String?
  sourceType        String?
  sourceId          String?
  sourceUrl         String?
  headline          String?
  body              String?
  mediaType         String?
  mediaUrl          String?
  ctwaClid          String?
  createdAt         DateTime        @default(now())
  conversation      Conversation    @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  orders            DeliveryOrder[]

  @@index([conversationId, createdAt])
  @@index([source, createdAt])
  @@index([sourceId])
  @@index([campaignCode])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  sender         String
  text           String
  metadata       String?
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id])

  // ⚠️ Existe um índice ÚNICO PARCIAL no banco que o Prisma não consegue declarar:
  //   CREATE UNIQUE INDEX "Message_inbound_provider_id_key"
  //     ON "Message"("conversationId", "metadata") WHERE "sender" = 'user';
  // (migration 20260811120000_message_provider_dedupe)
  // Ele é o que torna o dedupe do webhook ATÔMICO: `metadata` guarda o MessageSid/wamid
  // e duas entregas simultâneas do mesmo id não podem mais ser processadas as duas.
  // PARCIAL de propósito: no fluxo legado de busca, `metadata` de mensagens do
  // ASSISTENTE guarda um JSON de opções que legitimamente se repete — um índice global
  // quebraria aquele fluxo. Não troque por @@unique.
  @@index([conversationId, createdAt])
}

// Persistent, shared cache of raw Apify search results keyed by the normalized
// query, so repeat/refine/"me manda outras" and the prewarm cron serve results
// in ~1s instead of paying the ~50s Apify cold start. Stores the full scraped
// pool; ranking/offset/filtering happen per request from these items.
model SearchCache {
  queryKey  String   @id
  query     String
  source    String   @default("mercado_livre")
  items     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([updatedAt])
}

// OAuth da única conta operacional da Lia no Mercado Livre. Os tokens nunca vão para
// env, logs ou browser: ficam cifrados no banco com uma chave derivada do Client
// Secret, que só existe no runtime da Vercel.
model MercadoLivreOAuthCredential {
  id                    String   @id
  mercadoLivreUserId    String?
  accessTokenEncrypted  String
  refreshTokenEncrypted String
  expiresAt             DateTime
  scope                 String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([expiresAt])
}

// Demand from outside the current delivery area. When a customer sends a CEP we don't
// cover yet, the brain saves the lead here instead of taking a paid order it can't
// fulfil — and the /ops "lista de espera" turns these into a demand map (expand where
// people are already asking). Deduped by (phone, cep); hits counts repeat asks.
model WaitlistLead {
  id        String   @id @default(cuid())
  phone     String
  cep       String
  city      String?
  uf        String?
  // Por que virou lead: "outside_coverage" (cidade não atendida) ou "too_far" (cidade
  // atendida, mas longe de qualquer loja). Ajuda o /ops a priorizar o que abrir.
  reason    String   @default("outside_coverage")
  hits      Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([phone, cep])
  @@index([updatedAt])
}

// Re-hosted Petz product images. Petz self-hosts photos behind Akamai, so a server fetch
// (Twilio, our app) 403s — WhatsApp can't load them. The browser (which passes Akamai's
// JS sensor) fetches + resizes each image and POSTs it here; GET /api/petz-image/<id>
// then serves it from our own domain, which Twilio CAN fetch. Small resized JPEGs.
model PetzImage {
  id          String   @id // Petz product id (matches catalog sku PETZ-<id>)
  data        Bytes
  contentType String   @default("image/jpeg")
  bytes       Int      @default(0)
  updatedAt   DateTime @updatedAt
}

// Livro-razão do dinheiro (revisão 02/09): uma linha por pagamento conhecido no provedor
// (aprovado, ou recebido fora do esperado) e o que já foi estornado dele. "Pago" e
// "estornado" deixam de ser anotações: o estorno por API grava a referência sozinho.
model Payment {
  id                String        @id @default(cuid())
  deliveryOrderId   String
  // mercadopago | pagarme | mock
  provider          String
  providerPaymentId String
  // pix | card
  method            String
  amountCents       Int
  // approved | unexpected | partially_refunded | refunded
  status            String
  refundedCents     Int           @default(0)
  // Taxa do provedor e líquido recebido (23/09): lidos do próprio MP (fee_details /
  // transaction_details.net_received_amount) no webhook, na reconciliação ou no backfill
  // do cron. Nulo = ainda não lido; o P&L estima pela alíquota configurada.
  feeCents          Int?
  netCents          Int?
  refundReference   String?
  rawStatus         String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  // Cascade: pedido apagado (só limpeza de teste) leva o razão junto; em produção pedido não é apagado.
  deliveryOrder     DeliveryOrder @relation(fields: [deliveryOrderId], references: [id], onDelete: Cascade)

  @@unique([provider, providerPaymentId])
  @@index([deliveryOrderId])
  @@index([status, createdAt])
}

// Somente prontidão operacional. Senhas, cartão e cookies ficam no perfil local.
model PurchaseAccount {
  storeKey     String    @id
  label        String
  email        String?
  loginReady   Boolean   @default(false)
  paymentReady Boolean   @default(false)
  enabled      Boolean   @default(false)
  // Como a loja autentica o comprador (none | email_code | totp) e como paga
  // (card | pix_out | ml_balance). Nunca guarda credencial.
  authKind     String    @default("none")
  paymentKind  String    @default("card")
  lastSeenAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

// Um leitor reserva a próxima consulta; falha/ausência de mudança agenda outra leitura.
model TrackingSubscription {
  id               String        @id @default(cuid())
  deliveryOrderId  String        @unique
  storeKey         String
  storeOrderNumber String
  trackingUrl      String?
  nextCheckAt      DateTime      @default(now())
  lockedAt         DateTime?
  workerId         String?
  claimToken       String?
  lastCheckedAt    DateTime?
  lastError        String?
  failures         Int           @default(0)
  completedAt      DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  deliveryOrder    DeliveryOrder @relation(fields: [deliveryOrderId], references: [id], onDelete: Cascade)

  @@index([completedAt, nextCheckAt])
}

// Recebedor Pix aprovado por loja (o CNPJ do QR costuma ser do PSP, não da loja).
// pending: visto pela 1ª vez, aguarda um toque do dono; approved: pode pagar; blocked: nunca.
model PurchaseReceiver {
  id           String    @id @default(cuid())
  storeKey     String
  receiverDoc  String
  receiverName String
  status       String    @default("pending")
  approvedBy   String?
  approvedAt   DateTime?
  firstSeenAt  DateTime  @default(now())
  lastUsedAt   DateTime?
  timesUsed    Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([storeKey, receiverDoc])
}

// Ação pendente do operador (botão assinado no WhatsApp ou espelho no /ops).
// O consumo é um único UPDATE condicional: só quem virar pending→consumed executa.
model OpsAction {
  id              String    @id @default(cuid())
  kind            String
  purchaseJobId   String?
  deliveryOrderId String?
  payload         Json?
  status          String    @default("pending")
  expiresAt       DateTime
  consumedAt      DateTime?
  consumedBy      String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([status, expiresAt])
  @@index([purchaseJobId])
  @@index([deliveryOrderId])
}

// Pagamento Pix de saída (a Lia paga a loja). UM por job; criado antes da chamada ao
// banco; o EMV em claro nunca é gravado (só o hash e os campos decodificados).
model PixPayout {
  id               String    @id @default(cuid())
  purchaseJobId    String    @unique
  deliveryOrderId  String
  provider         String
  idempotencyKey   String    @unique
  status           String    @default("created")
  amountCents      Int
  codeHash         String
  txid             String?
  receiverDoc      String
  receiverName     String
  providerPayoutId String?   @unique
  endToEndId       String?   @unique
  expiresAt        DateTime?
  submittedAt      DateTime?
  settledAt        DateTime?
  lastError        String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([status, submittedAt])
  @@index([deliveryOrderId])
}

// E-mails transacionais das lojas já lidos pelo leitor no servidor (25/09/2026). Só o id
// da mensagem e o veredito; nunca o corpo.
model StoreMailSeen {
  messageId String   @id
  storeKey  String?
  kind      String
  matched   Boolean  @default(false)
  seenAt    DateTime @default(now())

  @@index([seenAt])
}

// Interruptores ligados em tempo de execução, sem deploy (06/10/2026). Hoje só o
// `offline`: a Lia responde a todo cliente com o aviso de instabilidade.
model AppFlag {
  key       String   @id
  value     String
  updatedBy String?
  updatedAt DateTime @updatedAt
}

// O que o cliente pediu e a Lia não achou (07/10/2026): alimenta a lista "Itens que o cliente
// pediu e não tínhamos" do /ops — demanda real para escolher lojas e catálogo. Só o hash do
// telefone e o prefixo do CEP (nunca o número nem o endereço). Gravação best-effort.
model SearchMiss {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  phoneHash String
  query     String
  // not_found | unbuyable (ver ListMissReason em conversation-types.ts)
  reason    String
  cepPrefix String?

  @@index([createdAt])
  @@index([query])
}
